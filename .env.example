# Adresa endpointu poptávkového formuláře (POST JSON, úspěch = HTTP 2xx).
# Vkládá se do JavaScriptu při `npm run build` – je veřejná, nepatří sem žádné tajemství.
# Bez hodnoty formulář zobrazí chybu a odkaz na e-mail (mailto), nic neodešle.
# Příklad s přiloženým backendem (public/contact.php): VITE_CONTACT_ENDPOINT=/contact.php
VITE_CONTACT_ENDPOINT=

# Měřicí ID Google Analytics 4 (G-XXXXXXXXXX). Prázdné = žádná analytika a žádná lišta cookies.
# GA4 se načte jen po souhlasu návštěvníka s analytickými cookies. ID je veřejné.
VITE_GA_ID=
