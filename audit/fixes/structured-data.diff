diff --git a/src/components/JsonLd.tsx b/src/components/JsonLd.tsx
new file mode 100644
index 0000000..15fce94
--- /dev/null
+++ b/src/components/JsonLd.tsx
@@ -0,0 +1,9 @@
+/** Structured data rendered next to the content it describes; `<` is escaped so text cannot close the script. */
+export function JsonLd({ data }: { data: object }) {
+  return (
+    <script
+      type="application/ld+json"
+      dangerouslySetInnerHTML={{ __html: JSON.stringify(data).replace(/</g, "\\u003c") }}
+    />
+  );
+}
