@@ -0,0 +1,33 @@
+name: CI
+
+on:
+  pull_request:
+  push:
+    branches: [main]
+
+permissions:
+  contents: read
+
+concurrency:
+  group: ci-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  check:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 24
+          cache: npm
+      - run: npm ci
+      - run: npm run lint --if-present
+      - run: npm test
+      - run: npm run build
+      - run: npm run check:build
+      # Celý strom: Vite, sharp a TypeScript běží při buildu v CI (devDependencies).
+      - run: npm audit --audit-level=high
+      - name: PHP syntaxe endpointu formuláře
+        run: if [ -f public/contact.php ]; then php -l public/contact.php; fi
diff --git a/.github/workflows/deploy.yml b/.github/workflows/deploy.yml
new file mode 100644
index 0000000..dccdc2a
--- /dev/null
+++ b/.github/workflows/deploy.yml
@@ -0,0 +1,99 @@
+name: Deploy
+
+# Nasazení: push tagu v* (např. v2026.11.01) nebo ručně. Rollback = ruční spuštění s předchozím tagem.
+on:
+  push:
+    tags: ["v*"]
+  workflow_dispatch:
+    inputs:
+      ref:
+        description: "Tag nebo commit k nasazení (rollback: předchozí tag)"
+        required: true
+        default: main
+      prune_assets:
+        description: "Smazat staré hashované soubory v /assets/ (jednou za čas, ne hned po vydání)"
+        type: boolean
+        default: false
+
+permissions:
+  contents: read
+
+concurrency:
+  group: deploy-production
+  cancel-in-progress: false
+
+jobs:
+  deploy:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 30
+    environment:
+      name: production
+      url: ${{ vars.SITE_URL || 'https://www.awclean.cz' }}
+    env:
+      SITE_URL: ${{ vars.SITE_URL || 'https://www.awclean.cz' }}
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: ${{ inputs.ref || github.ref }}
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 24
+          cache: npm
+      - run: npm ci
+      - run: npm test
+
+      - name: Build
+        env:
+          VITE_CONTACT_ENDPOINT: ${{ vars.VITE_CONTACT_ENDPOINT }}
+        run: |
+          test -n "$VITE_CONTACT_ENDPOINT" || { echo "::error::Chybí proměnná prostředí production VITE_CONTACT_ENDPOINT"; exit 1; }
+          npm run build
+          npm run check:build
+          grep -qF "$VITE_CONTACT_ENDPOINT" dist/assets/index-*.js
+          # Na Apache nepatří: pravidla pro Netlify a interní poznámky k fotkám.
+          rm -f dist/_redirects
+          find dist -name '*.md' -delete
+
+      - uses: actions/upload-artifact@v4
+        with:
+          name: dist-${{ github.sha }}
+          path: dist
+          include-hidden-files: true
+          retention-days: 90
+
+      - name: Install lftp
+        run: sudo apt-get update -qq && sudo apt-get install -y -qq lftp
+
+      - name: Upload
+        env:
+          DEPLOY_PROTOCOL: ${{ vars.DEPLOY_PROTOCOL }}
+          DEPLOY_PORT: ${{ vars.DEPLOY_PORT }}
+          DEPLOY_PATH: ${{ vars.DEPLOY_PATH }}
+          DEPLOY_HOST: ${{ secrets.DEPLOY_HOST }}
+          DEPLOY_USER: ${{ secrets.DEPLOY_USER }}
+          LFTP_PASSWORD: ${{ secrets.DEPLOY_PASSWORD }}
+          SSH_KEY: ${{ secrets.DEPLOY_SSH_KEY }}
+          KNOWN_HOSTS: ${{ secrets.DEPLOY_KNOWN_HOSTS }}
+          PRUNE_ASSETS: ${{ inputs.prune_assets && '1' || '0' }}
+        run: |
+          umask 077
+          mkdir -p ~/.ssh
+          printf '%s\n' "$KNOWN_HOSTS" > ~/.ssh/known_hosts
+          if [ -n "$SSH_KEY" ]; then
+            printf '%s\n' "$SSH_KEY" > ~/.ssh/deploy_key
+            export DEPLOY_KEY_FILE=~/.ssh/deploy_key
+          fi
+          sh scripts/deploy.sh
+
+      - name: Smoke test
+        run: |
+          set -eu
+          expected=$(grep -o '/assets/index-[A-Za-z0-9_-]*\.js' dist/index.html | head -n1)
+          live=$(curl -fsS "$SITE_URL/" | grep -o '/assets/index-[A-Za-z0-9_-]*\.js' | head -n1)
+          test "$live" = "$expected" || { echo "::error::Živá homepage odkazuje na $live, build na $expected"; exit 1; }
+          curl -fsS -o /dev/null "$SITE_URL$expected"
+          grep -o '<loc>[^<]*' dist/sitemap.xml | sed 's#<loc>https://[^/]*##' | while read -r path; do
+            curl -fsS -o /dev/null "$SITE_URL$path"
+          done
+          test "$(curl -s -o /dev/null -w '%{http_code}' "$SITE_URL/neexistuje/")" = 404
+          curl -fsSI "$SITE_URL/" | grep -qi '^content-security-policy:'
diff --git a/deploy/htaccess.template b/deploy/htaccess.template
new file mode 100644
index 0000000..1f8773f
--- /dev/null
+++ b/deploy/htaccess.template
@@ -0,0 +1,103 @@
+# AWCLEAN – konfigurace pro sdílený Apache (Wedos, svethostingu.cz) / LiteSpeed (Hostinger).
+# Generuje se při buildu z deploy/htaccess.template (vite.config.ts). Neupravovat v dist ani na FTP:
+# každý deploy soubor přepíše. Všechny direktivy patří do kategorií FileInfo/Indexes/Options=Indexes,
+# které povoluje i nejpřísnější sdílený hosting (Wedos zakazuje jiné volby Options, SetEnv, php_value).
+
+AddDefaultCharset utf-8
+AddCharset utf-8 .css .js .json .xml .txt .svg
+AddType font/woff2 .woff2
+AddType image/webp .webp
+DirectoryIndex index.html
+ErrorDocument 404 /404.html
+ErrorDocument 410 /404.html
+# ETag + komprese: mod_deflate přidává k ETag „-gzip“ a revalidace pak vrací 200 místo 304. Stačí Last-Modified.
+FileETag None
+Options -Indexes
+
+<IfModule mod_rewrite.c>
+  RewriteEngine On
+
+  # 1) Skryté a neveřejné soubory → 404 (ne 403, nic neprozrazuje). .well-known zůstává pro ACME.
+  RewriteRule (^|/)\.(?!well-known/) - [R=404,L]
+  RewriteRule (^|/)(composer\.(json|lock)|package(-lock)?\.json|vendor/|private/|config(\.[a-z]+)?$) - [R=404,L,NC]
+  RewriteRule \.(bak|old|orig|save|swp|tmp|dist|map|md|log|sql|sqlite|ini|env|ya?ml|lock|sh|zip|tar|gz|tgz|7z|rar)$ - [R=404,L,NC]
+  RewriteRule ~$ - [R=404,L]
+  RewriteRule ^_redirects$ - [R=404,L]
+
+  # 2) Migrace ze starého webu (Smartweb): PDF osvědčení a obrázky galerií. Absolutní cíl = jeden skok.
+  RewriteRule ^data/awclean\.cz/documents/Osvedcenie--AWCLEAN\.pdf$ @SITE_URL@/documents/osvedceni-awclean.pdf [R=301,L,NC]
+  RewriteCond %{DOCUMENT_ROOT}/images/projects/$1 -f
+  RewriteRule ^data/awclean\.cz/images/tmp/(.+)$ @SITE_URL@/images/projects/$1 [R=301,L]
+  # Mytí oken (stará URL v sitemap): ROZHODNE VLASTNÍK (SEO-5). Bez pravidla vrací 404.
+  # Pokud se služba už nedělá a má rychle zmizet z indexu, odkomentujte 410 Gone:
+  # RewriteRule ^ostatni-sluzby/myti-oken/?$ - [G]
+
+  # 3) Staré adresy (generováno z routeAliases v src/lib/routes.ts), absolutní cíl = jeden skok i z http/bez www.
+# @ALIASES@
+
+  # 4) Adresář bez koncového lomítka → rovnou kanonická adresa (mod_dir by udělal další skok přes původní host).
+  RewriteCond %{REQUEST_FILENAME} -d
+  RewriteRule ^(.+[^/])$ @SITE_URL@/$1/ [R=301,L]
+
+  # 5) Kanonická doména: awclean.cz → https://www.awclean.cz jedním skokem.
+  RewriteCond %{HTTP_HOST} ^awclean\.cz$ [NC]
+  RewriteRule ^ https://www.awclean.cz%{REQUEST_URI} [R=301,L]
+
+  # 6) HTTP → HTTPS. Na Smartwebu (nginx) i na většině hostingů to dělá hosting sám – nechte zakomentované.
+  #    Zapnout jen tam, kde přepínač hostingu zapisuje do www/.htaccess (Wedos), protože deploy ho přepíše.
+  #    Tři podmínky = žádná smyčka ani za TLS proxy/CDN. Ověření: curl -sI http://www.awclean.cz/ → jediný 301.
+  # RewriteCond %{HTTPS} !=on
+  # RewriteCond %{HTTP:X-Forwarded-Proto} !=https
+  # RewriteCond %{ENV:HTTPS} !=on
+  # RewriteRule ^ https://www.awclean.cz%{REQUEST_URI} [R=301,L]
+</IfModule>
+
+# Komprese: brotli tam, kde ho hosting má, jinak gzip. Obrázky/fonty jsou už komprimované.
+# AddOutputFilterByType patří do mod_filter: bez něj by direktiva shodila web chybou 500, proto vnořené IfModule.
+<IfModule mod_filter.c>
+  <IfModule mod_brotli.c>
+    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json image/svg+xml
+  </IfModule>
+  <IfModule mod_deflate.c>
+    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json image/svg+xml
+  </IfModule>
+</IfModule>
+
+<IfModule mod_headers.c>
+  Header unset ETag
+  # Cache: HTML/sitemap/robots vždy revalidovat; hashované soubory Vite (název-XXXXXXXX.js|css|woff2) rok;
+  # obrázky, fonty a PDF 30 dní (nemají hash v názvu).
+  <FilesMatch "\.(html|xml|txt)$">
+    Header set Cache-Control "no-cache"
+  </FilesMatch>
+  <FilesMatch "\.(webp|avif|jpe?g|png|svg|ico|gif|woff2?|pdf)$">
+    Header set Cache-Control "public, max-age=2592000"
+  </FilesMatch>
+  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2)$">
+    Header set Cache-Control "public, max-age=31536000, immutable"
+  </FilesMatch>
+  # Odpověď formuláře (osobní údaje) se nesmí ukládat do žádné cache.
+  <Files "contact.php">
+    Header always set Cache-Control "no-store"
+  </Files>
+
+  # Bezpečnostní hlavičky. connect-src/form-action 'self' pokrývají /contact.php na stejné doméně.
+  # style-src bez 'unsafe-inline': předvykreslené HTML nesmí obsahovat atribut style="" (prohlížeč ho zahodí);
+  # React style={…} po hydrataci je v pořádku. Hlídá to scripts/verify-build.ts.
+  # Varianta s Cloudflare Turnstile ve formuláři (SEC-3): do script-src i frame-src přidat
+  # https://challenges.cloudflare.com (frame-src 'none' → frame-src https://challenges.cloudflare.com).
+  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
+  Header always set X-Content-Type-Options "nosniff"
+  Header always set X-Frame-Options "DENY"
+  Header always set Referrer-Policy "strict-origin-when-cross-origin"
+  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
+  Header always set Cross-Origin-Opener-Policy "same-origin"
+  # CORP jen pro HTML: obrázky a PDF smějí vkládat i jiné weby (awclean.sk, Google Obrázky).
+  <FilesMatch "\.html$">
+    Header always set Cross-Origin-Resource-Policy "same-origin"
+  </FilesMatch>
+  # HSTS jen přes HTTPS. Současný web (Smartweb) už posílá max-age=31536000, prohlížeče návštěvníků ho
+  # mají uložený – snížení by nic nezměnilo, proto rovnou 1 rok. includeSubDomains/preload ne:
+  # mail.awclean.cz a webmail běží u Smartwebu a jejich HTTPS tu neřídíme.
+  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on' || %{HTTP:X-Forwarded-Proto} == 'https'"
+</IfModule>
diff --git a/public/contact.php b/public/contact.php
new file mode 100644
index 0000000..651ce42
--- /dev/null
+++ b/public/contact.php
@@ -0,0 +1,219 @@
+<?php
+// Endpoint kontaktního formuláře AWCLEAN (public/contact.php → dist/contact.php → webroot).
+// config.php, PHPMailer a rate-limit soubor leží v private/ o úroveň výš, nebo v private/ ve webrootu
+// chráněném vlastním .htaccess ("Require all denied").
+declare(strict_types=1);
+
+use PHPMailer\PHPMailer\Exception as MailException;
+use PHPMailer\PHPMailer\PHPMailer;
+
+ini_set('display_errors', '0');
+header('X-Content-Type-Options: nosniff');
+header('Cache-Control: no-store');
+
+const PHONE_HINT = 'Zavolejte nám prosím na +420 773 196 097 nebo napište na info@awclean.cz.';
+// Krátké názvy služeb = shortTitle ze src/data/pages/*.ts. Jiné hodnoty se tiše zahodí.
+const SERVICES = [
+    'Čištění fasád', 'Čištění střech', 'Čištění dlažeb', 'Čištění průmyslových objektů',
+    'Čištění světlíků', 'Hliníkové fasády', 'Historické fasády', 'Čištění pomníků',
+    'Nátěry střech a fasád (airless)', 'Impregnace fasád a střech', 'Nano impregnace',
+    'Odstraňování dopravního značení',
+];
+
+$isJson = str_starts_with(strtolower($_SERVER['CONTENT_TYPE'] ?? ''), 'application/json');
+$cfg = null;
+
+/** Ukončí request: JSON pro fetch, jinak 303 na Kontakt nebo jednoduchá HTML stránka. */
+function finish(int $status, array $errors = [], array $headers = []): never
+{
+    global $isJson, $cfg;
+    foreach ($headers as $h) header($h);
+    if ($isJson) {
+        http_response_code($status);
+        header('Content-Type: application/json; charset=utf-8');
+        echo json_encode($status === 200 ? ['ok' => true] : ['ok' => false, 'errors' => $errors], JSON_UNESCAPED_UNICODE);
+        exit;
+    }
+    if ($status === 200) {
+        header('Location: ' . $cfg['success_url'], true, 303);
+        exit;
+    }
+    http_response_code($status);
+    header('Content-Type: text/html; charset=utf-8');
+    $items = implode('', array_map(fn ($e) => '<li>' . htmlspecialchars($e, ENT_QUOTES, 'UTF-8') . '</li>', $errors));
+    echo '<!doctype html><html lang="cs"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">'
+        . '<meta name="robots" content="noindex"><title>Poptávku se nepodařilo odeslat | AWCLEAN</title>'
+        . '<body><h1>Poptávku se nepodařilo odeslat</h1><ul>' . $items . '</ul>'
+        . '<p><a href="/kontakt/#kontakt">Zpět na formulář</a> nebo nám zavolejte na <a href="tel:+420773196097">+420 773 196 097</a>.</p></body></html>';
+    exit;
+}
+
+/** Otevře rate-limit soubor se zámkem, předá data callbacku a uloží je. */
+function withLimits(callable $fn): mixed
+{
+    global $cfg;
+    $fh = fopen($cfg['ratelimit_file'], 'c+');
+    if ($fh === false || !flock($fh, LOCK_EX)) finish(503, ['form' => 'Formulář je dočasně nedostupný. ' . PHONE_HINT]);
+    $data = json_decode((string) stream_get_contents($fh), true);
+    $data = ['ip' => (array) ($data['ip'] ?? []), 'sent' => (array) ($data['sent'] ?? [])];
+    $result = $fn($data);
+    ftruncate($fh, 0);
+    rewind($fh);
+    fwrite($fh, json_encode($data));
+    flock($fh, LOCK_UN);
+    fclose($fh);
+    return $result;
+}
+
+foreach ([__DIR__ . '/../private/config.php', __DIR__ . '/private/config.php'] as $path) {
+    if (is_file($path)) {
+        $cfg = require $path;
+        break;
+    }
+}
+if (!is_array($cfg)) {
+    error_log('contact.php: config.php not found');
+    finish(503, ['form' => 'Formulář je dočasně nedostupný. ' . PHONE_HINT]);
+}
+require $cfg['phpmailer_dir'] . '/Exception.php';
+require $cfg['phpmailer_dir'] . '/PHPMailer.php';
+require $cfg['phpmailer_dir'] . '/SMTP.php';
+
+if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') {
+    finish(405, ['form' => 'Použijte prosím formulář na stránce Kontakt.'], ['Allow: POST']);
+}
+
+$origin = $_SERVER['HTTP_ORIGIN'] ?? '';
+if ($origin !== '' && !in_array($origin, $cfg['allowed_origins'], true)) {
+    finish(403, ['form' => 'Požadavek nepochází z webu AWCLEAN.']);
+}
+
+$maxBytes = 16 * 1024;
+if ((int) ($_SERVER['CONTENT_LENGTH'] ?? 0) > $maxBytes) {
+    finish(413, ['form' => 'Zpráva je příliš dlouhá.']);
+}
+
+if ($isJson) {
+    $raw = (string) stream_get_contents(fopen('php://input', 'rb'), $maxBytes + 1);
+    if (strlen($raw) > $maxBytes) finish(413, ['form' => 'Zpráva je příliš dlouhá.']);
+    $input = json_decode($raw, true, 4);
+    if (!is_array($input)) finish(400, ['form' => 'Neplatná data formuláře.']);
+} elseif (str_starts_with(strtolower($_SERVER['CONTENT_TYPE'] ?? ''), 'application/x-www-form-urlencoded')) {
+    $input = $_POST; // klasický POST bez JavaScriptu
+} else {
+    finish(415, ['form' => 'Nepodporovaný formát dat.']);
+}
+
+$field = static fn (string $k): string => is_string($input[$k] ?? null) ? $input[$k] : '';
+$values = [
+    'name' => trim($field('name')),
+    'phone' => trim($field('phone')),
+    'email' => trim($field('email')),
+    'message' => trim($field('message')),
+];
+$service = in_array($field('service'), SERVICES, true) ? $field('service') : '';
+$sample = $field('sample') === '1';
+
+// Honeypot: bot dostane stejnou odpověď jako člověk, e-mail se ale neodešle.
+if ($field('website') !== '') finish(200);
+
+// Doba vyplnění měřená v prohlížeči (fillMs = rozdíl dvou časů klienta) → posunuté hodiny nevadí.
+// Bez JS (klasický POST) údaj chybí, tam chrání honeypot, limit a případně Turnstile.
+$fillMs = $input['fillMs'] ?? null;
+if ($isJson && (!is_int($fillMs) || $fillMs < $cfg['min_fill_seconds'] * 1000 || $fillMs > 86_400_000)) {
+    finish(422, ['form' => 'Formulář byl odeslán příliš rychle. Počkejte prosím chvíli a odešlete ho znovu.']);
+}
+
+// Limit pokusů na IP (IP jen jako HMAC). Denní strop níže počítá jen skutečně odeslané e-maily.
+// ponytail: jeden soubor s globálním zámkem, pro desítky poptávek denně stačí; při vyšším provozu Redis/DB.
+$ip = (string) ($_SERVER[$cfg['client_ip_server_key']] ?? '');
+$ipKey = substr(hash_hmac('sha256', $ip, $cfg['secret']), 0, 32);
+$now = time();
+[$ipLimited, $capReached] = withLimits(static function (array &$data) use ($ipKey, $now, $cfg): array {
+    $data['ip'] = array_filter(array_map(
+        static fn ($list) => array_values(array_filter((array) $list, static fn ($t) => $t > $now - $cfg['rate_window_seconds'])),
+        $data['ip'],
+    ));
+    $data['sent'] = array_values(array_filter($data['sent'], static fn ($t) => $t > $now - 86400));
+    $ipLimited = count($data['ip'][$ipKey] ?? []) >= $cfg['rate_max_per_ip'];
+    if (!$ipLimited) $data['ip'][$ipKey][] = $now;
+    return [$ipLimited, count($data['sent']) >= $cfg['rate_max_per_day']];
+});
+if ($ipLimited) {
+    finish(429, ['form' => 'Odeslali jste příliš mnoho poptávek za krátkou dobu. Zkuste to prosím později nebo nám zavolejte.'], ['Retry-After: ' . $cfg['rate_window_seconds']]);
+}
+
+// Stejná pravidla jako src/lib/contact.ts validateContact + limity délek z formuláře.
+$errors = [];
+$len = static fn (string $s): int => mb_strlen($s, 'UTF-8');
+if ($len($values['name']) < 2 || $len($values['name']) > 200)
+    $errors['name'] = 'Vyplňte prosím jméno (alespoň 2 znaky).';
+if (!preg_match('/^\+?[\d\s()-]+$/u', $values['phone']) || !preg_match('/^[0-9]{9,15}$/', preg_replace('/\D/', '', $values['phone'])) || $len($values['phone']) > 30)
+    $errors['phone'] = 'Zadejte platný telefon, například +420 773 196 097.';
+if (!preg_match('/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/u', $values['email']) || $len($values['email']) > 200 || !PHPMailer::validateAddress($values['email']))
+    $errors['email'] = 'Zadejte platnou e-mailovou adresu.';
+if ($len($values['message']) < 10 || $len($values['message']) > 5000)
+    $errors['message'] = 'Popište prosím svůj požadavek alespoň 10 znaky.';
+foreach (['name', 'phone', 'email'] as $k) {
+    // CR/LF a řídicí znaky v jednořádkových polích = pokus o header injection.
+    if (preg_match('/[\x00-\x1F\x7F]/', $values[$k])) $errors[$k] = 'Pole obsahuje nepovolené znaky.';
+}
+if (!mb_check_encoding(implode('', $values), 'UTF-8')) $errors['form'] = 'Neplatné kódování textu.';
+if ($errors) finish(422, $errors);
+
+if ($capReached) {
+    error_log('contact.php: daily cap reached');
+    finish(503, ['form' => 'Poptávku teď nelze odeslat formulářem. ' . PHONE_HINT]);
+}
+
+if ($cfg['turnstile']['enabled']) {
+    $ch = curl_init('https://challenges.cloudflare.com/turnstile/v0/siteverify');
+    curl_setopt_array($ch, [
+        CURLOPT_POST => true,
+        CURLOPT_RETURNTRANSFER => true,
+        CURLOPT_TIMEOUT => 10,
+        CURLOPT_POSTFIELDS => http_build_query([
+            'secret' => $cfg['turnstile']['secret'],
+            'response' => $field('cf-turnstile-response'),
+            'remoteip' => $ip,
+        ]),
+    ]);
+    $verdict = json_decode((string) curl_exec($ch), true);
+    if (($verdict['success'] ?? false) !== true) finish(422, ['form' => 'Ověření, že nejste robot, se nezdařilo. Zkuste to prosím znovu.']);
+}
+
+$context = trim(($service !== '' ? " – $service" : '') . ($sample ? ' (ukázka zdarma)' : ''));
+$mail = new PHPMailer(true);
+try {
+    $mail->isSMTP();
+    $mail->Host = $cfg['smtp']['host'];
+    $mail->Port = $cfg['smtp']['port'];
+    $mail->SMTPSecure = $cfg['smtp']['secure'];
+    $mail->SMTPAutoTLS = $cfg['smtp']['secure'] !== '';
+    $mail->SMTPAuth = $cfg['smtp']['user'] !== '';
+    $mail->Username = $cfg['smtp']['user'];
+    $mail->Password = $cfg['smtp']['pass'];
+    $mail->Timeout = 10;
+    $mail->CharSet = PHPMailer::CHARSET_UTF8;
+    $mail->Encoding = PHPMailer::ENCODING_QUOTED_PRINTABLE;
+    $mail->setFrom($cfg['mail_from'], $cfg['mail_from_name'], false);
+    $mail->addAddress($cfg['mail_to']);
+    $mail->addReplyTo($values['email'], $values['name']);
+    $mail->Subject = 'Poptávka z webu: ' . $values['name'] . ($context !== '' ? ' ' . $context : '');
+    $mail->isHTML(false);
+    $mail->Body = "Nová poptávka z formuláře na www.awclean.cz\n\n"
+        . ($service !== '' ? "Služba: $service\n" : '')
+        . ($sample ? "Ukázka čištění zdarma: ano\n" : '')
+        . "Jméno: {$values['name']}\nTelefon: {$values['phone']}\nE-mail: {$values['email']}\n\n"
+        . "Zpráva:\n{$values['message']}\n\n"
+        . '-- Odpovědí na tento e-mail odpovíte přímo zákazníkovi.';
+    $mail->send();
+} catch (MailException) {
+    // Do logu jen technická chyba, žádné údaje z formuláře.
+    error_log('contact.php: SMTP send failed: ' . $mail->ErrorInfo);
+    finish(502, ['form' => 'Poptávku se nepodařilo odeslat. ' . PHONE_HINT]);
+}
+withLimits(static function (array &$data) use ($now): void {
+    $data['sent'][] = $now;
+});
+finish(200);
diff --git a/scripts/deploy.sh b/scripts/deploy.sh
new file mode 100644
index 0000000..d82c511
--- /dev/null
+++ b/scripts/deploy.sh
@@ -0,0 +1,55 @@
+#!/bin/sh
+# Nasazení dist/ na sdílený hosting přes lftp (SFTP, záložně FTPS) ve 4 krocích,
+# aby web během nahrávání nikdy neodkazoval na soubor, který ještě/už neexistuje:
+#   1. assets/  – hashované JS/CSS/fonty, jen přidat (staré zůstávají pro otevřené záložky)
+#   2. ostatní statické soubory (obrázky, maskot, PDF, favicony) – jen přidat
+#   3. HTML, .htaccess, sitemap, robots – vždy všechny (--transfer-all: stejná velikost i čas neznamená
+#      stejný obsah, hash v názvu assetu má pevnou délku), každý do dočasného souboru a přejmenovat
+#   4. smazat zastaralé soubory mimo assets/ a mimo chráněné cesty (private/, vendor/…; contact.php je v dist z public/)
+# Proměnné: DEPLOY_PROTOCOL=sftp|ftps, DEPLOY_HOST, DEPLOY_PORT, DEPLOY_USER, LFTP_PASSWORD,
+#   DEPLOY_PATH (např. /www, /public_html, domains/awclean.cz/public_html),
+#   volitelně DEPLOY_KEY_FILE (SFTP klíč), DEPLOY_KNOWN_HOSTS (soubor), PRUNE_ASSETS=1, DIST=dist
+set -eu
+DIST=${DIST:-dist}
+: "${DEPLOY_HOST:?}" "${DEPLOY_USER:?}" "${DEPLOY_PATH:?}"
+PROTO=${DEPLOY_PROTOCOL:-sftp}
+if [ ! -f "$DIST/index.html" ] || [ ! -f "$DIST/.htaccess" ]; then echo "Chybí $DIST/index.html nebo .htaccess" >&2; exit 1; fi
+
+# Soubory na serveru, které deploy nikdy nesmaže ani nepřepíše (backend formuláře, hosting, ACME).
+PROTECT="-x ^contact-config\.php$ -x ^vendor/ -x ^private/ -x ^\.well-known/ -x ^\.user\.ini$ -x ^cgi-bin/ -x ^domains/ -x ^subdom/ -x ^logs?/ -x ^stats/"
+M="mirror --reverse --no-perms --parallel=4 --verbose=1"
+
+if [ "$PROTO" = sftp ]; then
+  SSH="ssh -a -x -o StrictHostKeyChecking=yes -o UserKnownHostsFile=${DEPLOY_KNOWN_HOSTS:-$HOME/.ssh/known_hosts}"
+  if [ -n "${DEPLOY_KEY_FILE:-}" ]; then SSH="$SSH -i $DEPLOY_KEY_FILE"; fi
+  SETUP="set sftp:connect-program \"$SSH\"; set net:max-retries 3; set net:timeout 30"
+  URL="sftp://$DEPLOY_HOST:${DEPLOY_PORT:-22}"
+else
+  # FTPS (explicit TLS). Certifikát sdíleného hostingu bývá na jméno serveru, ne domény – DEPLOY_HOST = jméno serveru.
+  SETUP="set ftp:ssl-force true; set ftp:ssl-protect-data true; set ssl:verify-certificate true; set ftp:passive-mode true; set ftp:list-options -a; set net:max-retries 3; set net:timeout 30"
+  URL="ftp://$DEPLOY_HOST:${DEPLOY_PORT:-21}"
+fi
+# Prázdné heslo je u přihlášení klíčem v pořádku; --env-password čte LFTP_PASSWORD, heslo není v argv.
+export LFTP_PASSWORD="${LFTP_PASSWORD:-}"
+
+PRUNE_ASSETS_CMD=""
+if [ "${PRUNE_ASSETS:-0}" = 1 ]; then PRUNE_ASSETS_CMD="$M --delete --ignore-time $DIST/assets assets"; fi
+
+lftp -c "
+$SETUP
+set xfer:use-temp-file yes
+set xfer:temp-file-name .in.*
+open --env-password -u $DEPLOY_USER $URL
+mkdir -pf $DEPLOY_PATH
+cd $DEPLOY_PATH
+echo '== 1/4 assets'
+$M --ignore-time $DIST/assets assets
+echo '== 2/4 statické soubory'
+$M --ignore-time -x ^assets/ -x \.html$ -x ^\.htaccess$ -x ^sitemap\.xml$ -x ^robots\.txt$ $PROTECT $DIST .
+echo '== 3/4 HTML a konfigurace'
+$M --transfer-all -i \.html$ -i ^\.htaccess$ -i ^sitemap\.xml$ -i ^robots\.txt$ -x ^assets/ $PROTECT $DIST .
+echo '== 4/4 úklid'
+$M --delete --ignore-time -x ^assets/ -x '(^|/)\.in\.' $PROTECT $DIST .
+$PRUNE_ASSETS_CMD
+"
+echo "Nasazeno: $DIST → $DEPLOY_HOST:$DEPLOY_PATH"
