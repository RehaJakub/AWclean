  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Potřebuji na čištění fasády lešení?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Doktor radí: Lešení běžně nepotřebujete. AWCLEAN využívá lezeckou techniku a pracovní plošiny. Vhodný přístup k vašemu domu domluvíme při posouzení objektu."
        }
      },
      {
        "@type": "Question",
        "name": "Jak dlouho čištění trvá?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Doktor radí: Záleží na velikosti plochy, znečištění, přístupnosti a počasí. Po prohlídce vám navrhneme postup i předpokládanou dobu práce. Bez znalosti objektu počet dnů neslibujeme."
        }
      },
      {
        "@type": "Question",
        "name": "Nepoškodí chemie fasádu nebo okolní zeleň?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Doktor radí: Čisticí prostředek, tlak i dobu působení volíme podle materiálu a stavu fasády. Předem upozorněte na citlivé povrchy a zeleň u domu. Způsob jejich ochrany domluvíme před zahájením práce; univerzální bezrizikovost každého přípravku neslibujeme."
        }
      },
      {
        "@type": "Question",
        "name": "Jak funguje záruka 5, 10 nebo 20 let?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Doktor radí: Délka záruky závisí na vybraném ošetření a jeho podmínkách. AWCLEAN uvádí varianty 5, 10 a 20 let. Konkrétní rozsah a podmínky si nechte upřesnit v nabídce pro váš objekt."
        }
      },
      {
        "@type": "Question",
        "name": "Je referenční vzorek opravdu zdarma?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Doktor radí: Ano, ukázku čištění fasád, střech a dlažeb nabízíme po celé České republice zdarma. Na malé ploše uvidíte výsledek a pak se rozhodnete. U ostatních služeb si možnost ukázky domluvte individuálně."
        }
      },
      {
        "@type": "Question",
        "name": "Působíte po celé České republice?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Doktor radí: Ano, AWCLEAN působí po celé ČR i na Slovensku. Do poptávky napište místo realizace a typ povrchu, abychom mohli domluvit další postup."
        }
      }
