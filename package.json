{
  "name": "awclean-redesign",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "check:build": "node --experimental-strip-types scripts/verify-build.ts && node --experimental-strip-types scripts/check-gps.ts dist",
    "strip:gps": "node --experimental-strip-types scripts/strip-gps.ts public",
    "images": "node --experimental-strip-types scripts/generate-images.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "sharp": "^0.35.5",
    "typescript": "~5.7.3",
    "vite": "^6.2.0",
    "vitest": "^5.0.3"
  }
}
